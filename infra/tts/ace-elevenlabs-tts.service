[Unit]
Description=ACE ElevenLabs TTS gateway (Irodori-compatible /v1/audio/speech)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kyano
Group=kyano
WorkingDirectory=/home/kyano/workspace/ACE/ace_kagawa
# TOKKIO_ELEVENLABS_API_KEY, _VOICE_ID and _MODEL_ID come from the untracked Tokkio .env.
# Do not set their ELEVENLABS_* names here: those take precedence and would hide the .env values.
EnvironmentFile=/home/kyano/workspace/ACE/ace_kagawa/infra/tokkio/.env
Environment=ELEVENLABS_TTS_HOST=0.0.0.0
Environment=ELEVENLABS_TTS_PORT=8022
Environment=ELEVENLABS_TTS_VOICE=kagawa
Environment=ELEVENLABS_TTS_LANGUAGE_CODE=ja
Environment=ELEVENLABS_TTS_SAMPLE_RATE_HZ=16000
ExecStart=/home/kyano/workspace/ACE/ace_kagawa/Irodori-TTS/.venv/bin/python /home/kyano/workspace/ACE/ace_kagawa/infra/tts/elevenlabs_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Tokkio controller-side settings
# Copy to .env and fill the blanks before running prepare_tokkio_workspace.py.

TOKKIO_ACE_BRANCH=5.0.0-ga
TOKKIO_PROFILE=tokkio-1stream

TOKKIO_WORKSPACE_DIR=/home/kyano/workspace/ACE/ace_kagawa/infra/tokkio/workspace
TOKKIO_ACE_REPO_DIR=/home/kyano/workspace/ACE/ace_kagawa/infra/tokkio/workspace/NVIDIA-ACE
TOKKIO_CONTROLLER_DIR=/home/kyano/workspace/ACE/ace_kagawa/infra/tokkio/workspace/controller

TOKKIO_ENV_FILE_NAME=my-config.env
TOKKIO_CONFIG_FILE_NAME=ace-app-config.yml

TOKKIO_APP_HOST_IPV4_ADDR=
TOKKIO_APP_HOST_SSH_USER=
TOKKIO_COTURN_HOST_IPV4_ADDR=
TOKKIO_COTURN_HOST_SSH_USER=

TOKKIO_NVIDIA_API_KEY=
TOKKIO_NGC_CLI_API_KEY=
TOKKIO_OPENAI_API_KEY=
TOKKIO_ELEVENLABS_API_KEY=
# Voice for the host-side ElevenLabs gateway (infra/tts/elevenlabs_server.py).
# TOKKIO_ELEVENLABS_MODEL_ID defaults to eleven_v4_turbo when empty.
TOKKIO_ELEVENLABS_VOICE_ID=
TOKKIO_ELEVENLABS_MODEL_ID=

# Hosted NVIDIA NIM endpoint for Tokkio NvidiaLLMService.
# Leave TOKKIO_LLM_API_KEY empty to reuse TOKKIO_NVIDIA_API_KEY.
TOKKIO_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
TOKKIO_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
TOKKIO_LLM_API_KEY=

# RAG routing. mode controls when a turn uses RAG; provider controls how the
# routed turn is retrieved. Use provider=local for the SQLite index built from
# data/rag/corpus; use provider=nvidia for NVIDIA RAG Blueprint.
TOKKIO_RAG_ENABLED=true
TOKKIO_RAG_MODE=auto
TOKKIO_RAG_PROVIDER=local
TOKKIO_RAG_SERVER_URL=
TOKKIO_RAG_COLLECTION_NAME=ace_kagawa
TOKKIO_RAG_USE_KNOWLEDGE_BASE=true
TOKKIO_RAG_MAX_TOKENS=64
TOKKIO_RAG_VDB_TOP_K=12
TOKKIO_RAG_RERANKER_TOP_K=5
TOKKIO_RAG_MULTIMODAL_RERANKER_TOP_K=10
TOKKIO_RAG_ENABLE_RERANKER=true
TOKKIO_RAG_SUFFIX_PROMPT=日本語で通常40から60文字、原則1文で簡潔に答えてください。詳しい説明を求められた場合だけ100文字以内、最大2文にしてください。香川先生や香川豊先生について聞かれた場合は、自分のこととして「私は」または「私の」で答えてください。箇条書きは求められた時だけにしてください。
TOKKIO_RAG_ROUTE_KEYWORDS="香川先生,香川豊,東京工科大学,大学概要,学部,学科,専攻,アクセス,入試,受験,選抜,総合型選抜,学費,入学金,授業料,奨学金,オープンキャンパス,パンフレット,大学案内,学生支援,スパコン,スーパーコンピュータ,青嵐,SEIRAN,DGX B200,論文,文献,出典,根拠,資料,ドキュメント,引用,経歴,学歴,職歴,略歴,役職,現職,職名,学位,所属,生年月日,年齢,プロフィール,誰ですか,専門分野,業績,研究業績,研究内容,研究,プロジェクト,発表,受賞,特許,EBC,CMC,SiC/SiC,非破壊評価"
TOKKIO_RAG_FALLBACK_TO_LLM_ON_ERROR=false
TOKKIO_RAG_HEALTH_URL=http://127.0.0.1:8081/v1/health?check_dependencies=true
TOKKIO_LOCAL_RAG_CORPUS=data/rag/corpus
TOKKIO_LOCAL_RAG_DB=data/rag/local/local_rag.sqlite
TOKKIO_LOCAL_RAG_RUNTIME_DB_PATH=/code/configs/local_rag.sqlite
TOKKIO_LOCAL_RAG_TOP_K=3
TOKKIO_LOCAL_RAG_MAX_CONTEXT_CHARS=2800

# Select the Tokkio TTS backend. Use IrodoriTTSService for Japanese or
# QwenTTSService for the English IndexTTS-2.5 voice clone. The selector and
# TOKKIO_QWEN_TTS_* names are retained as HTTP transport compatibility names.
TOKKIO_TTS_PROCESSOR=IrodoriTTSService

# Host-side Japanese Irodori-TTS endpoint.
# To speak through ElevenLabs instead, keep TOKKIO_TTS_PROCESSOR=IrodoriTTSService
# and point these at the ElevenLabs gateway, which serves the same API:
#   TOKKIO_IRODORI_TTS_BASE_URL=http://<TOKKIO_APP_HOST_IPV4_ADDR>:8022
#   TOKKIO_IRODORI_TTS_HEALTH_URL=http://127.0.0.1:8022/healthz
#   TOKKIO_IRODORI_TTS_SERVICE=ace-elevenlabs-tts.service
#   TOKKIO_TTS_SYNTHESIS_CHECK_ENABLED=false
# The last line avoids one billed ElevenLabs request on every manage_tokkio.sh
# status/start/restart/reapply; the gateway has no cache for the check phrase.
TOKKIO_IRODORI_TTS_ENABLED=true
TOKKIO_IRODORI_TTS_BASE_URL=
TOKKIO_IRODORI_TTS_HEALTH_URL=http://127.0.0.1:8021/healthz
TOKKIO_IRODORI_TTS_SERVICE=ace-irodori-tts.service
# manage_tokkio.sh status/start/restart/reapply also POST a short phrase to the
# Japanese TTS and require 16 kHz PCM. Set false to check /healthz only.
TOKKIO_TTS_SYNTHESIS_CHECK_ENABLED=true

# Host-side English IndexTTS-2.5 endpoint. Defaults to
# http://<TOKKIO_APP_HOST_IPV4_ADDR>:8023 when base URL is empty.
# With TOKKIO_TTS_PROCESSOR=QwenTTSService set this to true or leave it empty
# (empty means true); an explicit false makes start/restart stop with an error.
TOKKIO_QWEN_TTS_ENABLED=false
TOKKIO_QWEN_TTS_BASE_URL=
TOKKIO_QWEN_TTS_HEALTH_URL=http://127.0.0.1:8023/healthz
TOKKIO_QWEN_TTS_SERVICE=ace-indextts-tts.service

# Optional controller hot-reload sync settings.
# TOKKIO_CONTROLLER_SOURCE_DIR defaults to:
#   <TOKKIO_ACE_REPO_DIR>/workflows/tokkio/<TOKKIO_ACE_BRANCH>/src/llm-rag
TOKKIO_CONTROLLER_SOURCE_DIR=
TOKKIO_CONTROLLER_READY_TIMEOUT=300s

# Optional URLs for post-install verification.
TOKKIO_UI_URL=
TOKKIO_API_URL=
TOKKIO_GRAFANA_URL=
# start/restart/reapply retry the UI/API/Grafana checks up to ATTEMPTS times,
# SECONDS apart, while the restored pods come up; status checks once.
TOKKIO_ENDPOINT_WAIT_ATTEMPTS=36
TOKKIO_ENDPOINT_WAIT_SECONDS=5

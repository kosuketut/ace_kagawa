NGC_API_KEY=replace-me

# Speech NIM image names.
ASR_NIM_IMAGE=nvcr.io/nim/nvidia/nemotron-3.5-asr-streaming-0.6b:latest
TTS_NIM_IMAGE=nvcr.io/nim/nvidia/magpie-tts-multilingual:latest

# Realtime-friendly defaults. Leave ASR selector empty unless the selected ASR
# image documents an alternate profile selector.
ASR_NIM_TAGS_SELECTOR=
TTS_NIM_TAGS_SELECTOR=name=magpie-tts-multilingual,batch_size=8

ASR_GRPC_PORT=50051
ASR_HTTP_PORT=9000
TTS_GRPC_PORT=50052
TTS_HTTP_PORT=9001
